{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cl-workbench hook claude-code parens",
            "timeout": 15,
            "statusMessage": "Checking Lisp delimiters..."
          }
        ]
      }
    ]
  }
}
