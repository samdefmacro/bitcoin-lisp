  "Core vRPCConvertParams: (method position name format), FORMAT one of
:JSON (parse as JSON, fail on bad JSON), :STRING (never parse; listed so
-named does not split a value containing `=') and :JSON-OR-STRING (parse,
and pass the raw text as a string when it is not JSON).")

(defun %convert-from-position (method pos)
  (find-if (lambda (row) (and (string= (first row) method) (= (second row) pos)))
           *rpc-convert-params*))

(defun %convert-from-name (method name)
  (find-if (lambda (row) (and (string= (first row) method) (string= (third row) name)))
           *rpc-convert-params*))

(defun %parse-json-arg (raw format)
  "Core Parse (client.cpp:395-404): RAW as JSON; for :JSON-OR-STRING a failed
parse is the raw string, for :JSON it is `Error parsing JSON: RAW'."
  (handler-case (uv-read raw)
    (json-parse-failure ()
      (if (eq format :json-or-string)
          raw
          (cli-error "Error parsing JSON: ~A" raw)))))

(defun %parse-param (row raw)
  "Core ParseParam (client.cpp:426-430)."
  (if (and row (member (fourth row) '(:json :json-or-string)))
      (%parse-json-arg raw (fourth row))
      raw))

(defun rpc-convert-values (method args)
  "Core RPCConvertValues (client.cpp:435-445): the positional ARGS (strings)
as a params array, each converted by its (METHOD, position) row."
  (cons :arr (loop for s in args
                   for i from 0
                   collect (%parse-param (%convert-from-position method i) s))))

(defun rpc-convert-named-values (method args)
  "Core RPCConvertNamedValues (client.cpp:475-517): -named ARGS as a params
object. An argument without `=' is positional; NAME=VALUE is named unless NAME
is not one of METHOD's listed names AND the next positional slot is a JSON one
the whole argument parses as, or a string one -- the two escapes that let
`[\"key=value\"]' and `my=wallet' through as positional values. A later NAME
overwrites an earlier one in place; positional arguments go last, under
\"args\" -- appended by pushKVEnd even when an explicit args= is there, so the
server sees the key twice."
  (let ((named nil) (positional nil))
    (dolist (s args)
      (let ((eq-pos (position #\= s)))
        (if (null eq-pos)
            (push (%parse-param (%convert-from-position method (length positional)) s)
                  positional)
            (let* ((name (subseq s 0 eq-pos))
                   (value (subseq s (1+ eq-pos)))
                   (named-row (%convert-from-name method name))
                   (pos-row (and (null named-row)
                                 (%convert-from-position method (length positional))))
                   (as-json (and pos-row (eq (fourth pos-row) :json)
                                 (handler-case (uv-read s)
                                   (json-parse-failure () nil)))))
              (cond (as-json (push as-json positional))
                    ((and pos-row (eq (fourth pos-row) :string)) (push s positional))
                    (t
                     (let ((parsed (%parse-param named-row value))
                           (cell (assoc name named :test #'string=)))
                       ;; UniValue::pushKV replaces an existing key in place.
                       (if cell
                           (setf (cdr cell) parsed)
                           (push (cons name parsed) named)))))))))
    (setf named (nreverse named))
    ;; pushKVEnd APPENDS, even when an explicit args= already holds the key:
    ;; the request then names args twice and the server refuses it
    ;; (rpc/server.cpp:374-382), rather than the client silently choosing.
    (when positional
      (setf named (append named (list (cons "args" (cons :arr (nreverse positional)))))))
    (cons :obj named)))
