*.wx32fsl

# SBCL
*.core

# Quicklisp
quicklisp/

# Build artifacts
build/
bin/

# Data directories. NOTE the trailing-slash-only patterns match at ANY depth,
# so a bare `data/' also swallowed tests/data/ and a fresh clone hard-errored on
# the taproot vector test with FILE-DOES-NOT-EXIST. Anchor them to the repo root
# and keep the test vectors tracked.
/data/
/blocks/
!tests/data/

# Editor backups
*~
\#*\#
.\#*

# Reference repos (optional, for reading upstream code)
refs/

# macOS
.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Manual/debug test scripts
tests/manual-sync-test.lisp
tests/quick-debug-test.lisp

# Claude Code: .claude/settings.json (the cl-workbench paren-hook stanza) is
# TRACKED so the hook fires in every clone and worktree. Only the local
# permission overrides (and their backups) and worktree state stay ignored.
.claude/settings.local.json*
.claude/worktrees/

# Agent dev-runtime (cl-agent-repl)
.dev-runtime/

# Common Lisp Workbench runtime state (descriptors, event spool)
/.cl-workbench/state/
build/
# Generated by scripts/conformance-config.sh (absolute paths, machine-local)
/test/config.ini
